# --- Sources -----------------------------------------------------------
# fixtures = synthetic videos, runs with no keys (for demos/tests). live = real Instagram/Meta data via Apify.
SOURCE_MODE=fixtures
APIFY_TOKEN=
# Actor ids are configurable because actor schemas/availability change; see README "Video sources".
APIFY_IG_ACTOR=apify~instagram-hashtag-scraper
APIFY_META_ACTOR=apify~facebook-ads-scraper
APIFY_TIKTOK_ACTOR=clockworks~tiktok-hashtag-scraper
META_ADS_COUNTRY=US
ENABLE_TIKTOK=false

# --- Image brain (pick ONE; all have a free option) ----------------------
# Option 1 (easiest, free): Google Gemini free tier. Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Option 2 (free, no account, runs locally): Ollama. `ollama pull qwen2.5vl:7b`, then set the URL.
#   Docker on Mac/Windows reaches the host at http://host.docker.internal:11434
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5vl:7b
# Option 3 (paid): Anthropic
ANTHROPIC_API_KEY=
VISION_MODEL=claude-haiku-5-5
# auto = gemini > ollama > anthropic, whichever is configured. With none, text-only heuristic scoring is used.
VISION_PROVIDER=auto
# Free tiers are rate limited: cap model calls per minute and judge several thumbnails per call.
VISION_RPM=15
VISION_BATCH=8

# --- Pipeline tuning (defaults shown) ----------------------------------
TARGET_PER_SOURCE=20
MATCH_THRESHOLD=60
WEAK_THRESHOLD=40
MAX_ROUNDS=4
CANDIDATES_PER_ROUND=40

# --- Infra (docker-compose overrides these) ----------------------------
PORT=8080
REDIS_URL=redis://localhost:6379
DB_PATH=./data/app.db
CORS_ORIGIN=http://localhost:5173
